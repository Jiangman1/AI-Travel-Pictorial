# 复制为项目根目录的 .env 后填写真实值（.env 已被 .gitignore 忽略）

# ---- 文案生成：DeepSeek（OpenAI 兼容接口）----
# Key 获取：https://platform.deepseek.com/api_keys
# 可选模型：deepseek-chat（推荐，速度快、结构化输出稳定）
#           deepseek-reasoner（推理模型，更慢，一般不需要）
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# ---- 其他 OpenAI 兼容服务示例（二选一，改上面三行即可）----
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1 ，模型 qwen-plus
# OpenAI：    https://api.openai.com/v1 ，模型 gpt-4o-mini

# ---- AI 生图：阿里云百炼（IMAGE_SOURCE=ai 时必填）----
# DeepSeek 不提供生图；不用 AI 配图时可以留空
# 控制台：https://bailian.console.aliyun.com/
BAILIAN_API_KEY=

# ---- 配图方式：ai（百炼生图，1 张）| baidu（百度图片下载，最多 4 张）----
# 没有百炼 Key 时保持 baidu
IMAGE_SOURCE=baidu

# ---- 百炼生图模型 ----
# 以控制台「模型广场 → 图像生成」里的模型 ID 为准，改这一行即可切换，无需改代码
# 常见可选：qwen-image-2.1-pro（默认）/ qwen-image-2.0-pro / qwen-image-plus
# 若账户未开通某个模型，会返回 403 AccessDenied，换一个即可
BAILIAN_IMAGE_MODEL=qwen-image-2.1-pro
# 出图尺寸，格式 宽*高；不同模型支持的分辨率不同，报 400 InvalidParameter 时改小一点
BAILIAN_IMAGE_SIZE=2048*2048
